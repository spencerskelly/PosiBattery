filters:
  and:
    - file.inFolder("10_Products")
    - file.ext == "md"
    - '!file.name.startsWith("README_")'
views:
  - type: table
    name: All products by category
    order:
      - file.name
      - subtypeOf
      - madeBy
      - offeredBy
      - file.folder
      - status
    sort:
      - property: subtypeOf
        direction: ASC
