filters:
  and:
    - file.inFolder("Battery Products")
    - file.ext == "md"
    - '!file.name.startsWith("README_")'
views:
  - type: table
    name: All notes
    order:
      - file.name
      - file.folder
      - type
      - subtype
      - id
      - status
  - type: table
    name: Abstract families
    filters:
      and:
        - abstract == true
    order:
      - file.name
      - subtype
      - id
      - status
