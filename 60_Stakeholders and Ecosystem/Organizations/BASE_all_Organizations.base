filters:
  and:
    - file.inFolder("60_Stakeholders and Ecosystem/Organizations")
    - file.ext == "md"
    - '!file.name.startsWith("README_")'
views:
  - type: table
    name: Ecosystem inventory
    order:
      - file.name
      - id
      - status
      - playsRole
      - makes
      - offers
      - parentOf
      - subsidiaryOf
      - distributorOf
      - distributedBy
      - supplierOf
      - suppliedBy
      - partnerOf
      - integratesWith
      - tags
